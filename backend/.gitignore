# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# ML models (mounted as volume)
ml_models/*.pt
ml_models/*.onnx

# Data
data/

# Uploads (user-generated files, served as static assets)
# Ignore all upload content but preserve directory structure via .gitkeep
uploads/**
!uploads/.gitkeep
!uploads/.gitignore
!uploads/*/
!uploads/*/.gitkeep

# Alembic
alembic/versions/*.py

# Test cache
.pytest_cache/
.coverage
htmlcov/
